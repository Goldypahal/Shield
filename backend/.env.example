# Copy to backend/.env. Never commit the real file.

# development | test | production. Production refuses to start with insecure settings.
SHIELD_ENV=development

# Required in production, at least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# true = /auth/register is open and OTP codes are returned in the API response.
# Must be false in production (it is refused there).
SHIELD_DEMO_MODE=true

# Comma-separated browser origins allowed to call the API (dashboard, Expo web)
CORS_ORIGINS=http://localhost:8000,http://localhost:8081,http://localhost:19006

# Email for verification codes (sign-up, password reset, SOS PIN change). Required in production.
# Gmail: turn on 2-Step Verification, create an App Password (Google Account > Security >
# App passwords) and use it below. Never use your normal Gmail password.
# Leave SMTP_HOST blank in development: with SHIELD_DEMO_MODE=true the codes are shown in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Police integration. ERSS_MODE: off | mock | http (http needs approval from the state 112/ERSS).
ERSS_MODE=mock
ERSS_ENDPOINT=
ERSS_API_KEY=
ERSS_WEBHOOK_SECRET=
# Seconds a station has to acknowledge before the control room is alerted
POLICE_ACK_SECONDS=180
# Days to keep location trails and unconsented evidence of closed alerts
RETENTION_DAYS=90

# Public URL used in SMS links to the guardian tracking page (/track/<token>)
PUBLIC_APP_URL=http://localhost:8000

# Signing key for the Bluetooth SOS relay. A walker with no signal broadcasts a signed
# packet over BLE; a nearby SHIELD phone with connectivity uploads it on their behalf.
# Set this to its own random value (NOT the JWT secret): the app ships the same key, so
# it is only ever as secret as an installed app bundle.
BLE_RELAY_SECRET=

# SMS for guardian alerts and OTP codes. Leave blank to log instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CARTO basemaps (dashboard + route maps). Leave blank for CARTO's public dark tiles.
CARTO_API_KEY=

# Safe-route graph. Default is the bundled synthetic lattice (backend/routing/data/tricity_graph.json),
# whose routes do not follow real streets. For routes that match the map, build the real-OSM graph
#   cd backend/routing && python -m heimdal_routing osm --out data/tricity_osm_walk.json --network walk
# and point this at it (absolute path).
# SHIELD_ROUTING_GRAPH=C:/Heimdal/heimdal-routing/data/tricity_osm_walk.json

# Storage (defaults shown; the Docker image uses /data)
# SHIELD_DB_PATH=backend/db/shield.db
# SHIELD_EVIDENCE_DIR=backend/secure_storage
# REDIS_URL=redis://localhost:6380/0

# Only for: docker compose --profile postgis up
POSTGRES_PASSWORD=change-me

# All-India navigation (/api/v1/nav). Free OpenStreetMap services are used by default.
# Add a Google Maps Platform key (Routes API + Places API (New) enabled) to switch routing
# and place search to Google: live traffic, two-wheeler routes and public transit.
# GOOGLE_MAPS_API_KEY=
# For production without Google, self-host OSRM (India extract) and Photon, then point here:
# OSRM_CAR_URL=http://osrm-car:5000/route/v1/driving
# OSRM_BIKE_URL=http://osrm-bike:5000/route/v1/bike
# OSRM_FOOT_URL=http://osrm-foot:5000/route/v1/foot
# PHOTON_URL=http://photon:2322
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
