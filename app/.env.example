# Copy to app/.env and fill in. Values are baked into the bundle at build time,
# so never put server secrets (Twilio, JWT) here.

# Backend API. On a phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8000

# Optional Firebase fallback channel (leave blank to disable)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
