# Copy to app/.env and fill in. Values are baked into the bundle at build time,
# so never put server secrets (Twilio, JWT) here.

# Backend API. On a phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8000

# Optional Firebase fallback channel (leave blank to disable)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Map style for the Routes tab (MapLibre). Default: OpenFreeMap "liberty" (free, no key).
# Any MapLibre style URL works, e.g. one that draws India's boundaries per Survey of India.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Development builds only: sign in this test account automatically so testers skip the
# sign-in screen. Create it once in the app (or via the backend) first. Ignored in release builds.
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=tester@example.com
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD=
